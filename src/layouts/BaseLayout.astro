---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = "Mi Portafolio" } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>