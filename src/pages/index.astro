---
import Background from '../components/layout/Background.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Comunity from '../components/sections/Comunity.astro';
import ExperienciaB from '../components/sections/ExperienciaB.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>

  <!-- BACKGROUND GLOBAL (FESTI PRO STYLE) -->
  <Background />

  <!-- HEADER -->
  <Header />

  <!-- CONTENIDO -->
  <main class="relative z-10">
    <Hero />
    <ExperienciaB />
    <Projects />
    <Comunity />
  </main>

  <Footer />

</BaseLayout>
