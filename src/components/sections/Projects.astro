---
import { ExternalLink } from "lucide-astro";

const projects = [
  {
    title: "MailCraft",
    mark: "MC",
    type: "Editor visual",
    stack: ["Angular 21", "TypeScript", "GrapesJS", "Vitest"],
    description: "Editor visual para crear plantillas de correo electrónico mediante bloques reutilizables.",
    detail: "Aplicación web responsive para construir correos HTML arrastrando bloques al lienzo, personalizar sus propiedades y revisar el resultado en escritorio, tablet y móvil. Su arquitectura utiliza componentes standalone, Angular Signals y servicios inyectables.",
    highlights: ["Editor drag and drop con bloques y columnas", "Inspector contextual de estilos y propiedades", "Historial con deshacer y rehacer", "Guardado local y exportación a HTML autocontenido"],
    image: "/images/email.png",
    github: "https://github.com/MarcelaMV2/email-template-builder",
  },
  {
    title: "FIRST Global Robotics",
    mark: "FG",
    type: "Visualización de datos",
    stack: ["Astro", "TypeScript", "Google Sheets", "Vercel"],
    description: "Plataforma para visualizar y analizar resultados de una evaluación nacional de robótica.",
    detail: "Transforma datos de evaluación almacenados en Google Sheets en una experiencia web clara e interactiva. Permite comparar el rendimiento de los equipos participantes de FIRST Global y consultar sus resultados por áreas técnicas.",
    highlights: ["Ranking y puntaje acumulado de equipos", "Evaluaciones organizadas por áreas técnicas", "Consumo de datos desde Google Sheets en modo lectura", "Visualización histórica de resultados"],
    image: "/images/first-global.png",
    github: "https://github.com/MarcelaMV2/first-global",
    demo: "https://first-global.vercel.app/",
  },
  {
    title: "ChaliTaxi",
    mark: "CT",
    type: "App móvil · Hackatón",
    stack: ["Flutter", "Dart", "Android Studio"],
    description: "Aplicación móvil para calcular un precio justo del viaje según la distancia y la tarifa oficial de Sucre.",
    detail: "Aplicación móvil desarrollada con Flutter durante la Hackatón del Congreso Nacional de Ciencias de la Computación (CCBOL), realizada en Sucre. ChaliTaxi funciona como un taxímetro en el celular: toma la distancia recorrida como referencia y aplica la tarifa establecida para ofrecer un cobro más claro, justo y transparente.",
    highlights: ["Mención especial en la Hackatón CCBOL 2024", "Cálculo del costo según distancia y tarifa oficial", "Aplicación móvil desarrollada con Flutter", "Desarrollo colaborativo bajo el tiempo limitado de una hackatón"],
    image: "/images/chalitaxi.png",
    github: null,
    codeStatus: "Código próximamente",
  },
  {
    title: "Sansa Designs",
    mark: "SD",
    type: "E-commerce",
    stack: ["NestJS", "Vue", "MySQL"],
    description: "Sistema de gestión integral para un emprendimiento textil artesanal boliviano.",
    detail: "Centraliza el catálogo, inventario, proveedores, pedidos y pagos para simplificar la operación diaria del emprendimiento y mantener la información organizada.",
    highlights: ["Control de inventario y proveedores", "Gestión de pedidos y pagos", "Reportes automáticos y catálogo centralizado"],
    image: "/images/sansa.png",
    github: "https://github.com/MarcelaMV2/sis257_tienda_textiles",
  },
  {
    title: "GogoPlay",
    mark: "GP",
    type: "E-commerce",
    stack: ["NestJS", "Vue"],
    description: "Plataforma de venta online de juguetes con una experiencia de compra fluida.",
    detail: "Aplicación web para administrar un catálogo de juguetes y acompañar al usuario durante todo el proceso de compra.",
    highlights: ["Administración de productos", "Carrito de compras", "Procesamiento y seguimiento de pedidos"],
    image: "/images/gogoplay.png",
    github: "https://github.com/MarcelaMV2/ecommerceSIS324-GoGoPlay",
  },
  {
    title: "Nexo",
    mark: "NX",
    type: "Reclutamiento IA",
    stack: ["Laravel", "React", "n8n"],
    description: "Aplicación de reclutamiento inteligente con validaciones y decisiones automatizadas.",
    detail: "Los formularios se adaptan al proceso de selección y n8n funciona como motor de decisiones para coordinar automáticamente las siguientes etapas.",
    highlights: ["Formularios y validaciones dinámicas", "Agenda o rechazo automatizado", "Reprogramación autónoma de entrevistas"],
    image: "/images/nexo.png",
    github: "https://github.com/MarcelaMV2/frontend_nexo",
  },
  {
    title: "Ingeniería Económica",
    mark: "IE",
    type: "Finanzas",
    stack: ["Svelte", "JavaScript"],
    description: "Calculadora web para analizar indicadores financieros y evaluar inversiones.",
    detail: "Herramienta académica que reúne cálculos habituales de ingeniería económica en una interfaz rápida, clara y reactiva.",
    highlights: ["Cálculo de indicadores financieros", "Evaluación de proyectos", "Interfaz reactiva y fácil de utilizar"],
    image: "/images/calculadora.png",
    github: null,
  },
  {
    title: "Venta de Boletos",
    mark: "VB",
    type: "Microservicios",
    stack: ["Angular", "NestJS"],
    description: "Arquitectura de microservicios para gestionar y vender boletos.",
    detail: "Sistema distribuido que separa las responsabilidades del negocio en servicios independientes para facilitar su mantenimiento y escalabilidad.",
    highlights: ["Servicios independientes", "Gestión centralizada de boletos", "Arquitectura modular y escalable"],
    image: "/images/microservicios.png",
    github: "https://github.com/Gonzales-Franz-Reinaldo/proyecto-microservicios",
  },
  {
    title: "MicroFinder",
    mark: "MF",
    type: "App móvil",
    stack: ["React Native", "Mapas"],
    description: "Aplicación móvil para visualizar rutas de microbuses en Sucre, Bolivia.",
    detail: "Propuesta de movilidad urbana que facilita la búsqueda y visualización de recorridos para que desplazarse por la ciudad sea más sencillo.",
    highlights: ["Consulta de rutas urbanas", "Visualización sobre mapas", "Experiencia móvil accesible"],
    image: "/images/microfinder.png",
    github: "https://github.com/MarcelaMV2/MicroFinder",
  },
];
---

<section class="pb-12 pt-8 md:pb-14 md:pt-10" id="projects" aria-labelledby="projects-title">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-12 max-w-2xl">
      <span class="text-muted-sem font-mono text-sm uppercase tracking-widest">Proyectos</span>
      <h2 id="projects-title" class="mt-2 text-3xl font-bold text-primary md:text-4xl">Lo que he construido</h2>
      <p class="mt-3 text-secondary">Selecciona una tarjeta para conocer el proyecto con más detalle.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, index) => (
        <article
          class="project-card group flex cursor-pointer flex-col overflow-hidden rounded-2xl"
          data-project-index={index}
          tabindex="0"
          role="button"
          aria-label={`Ver detalles de ${project.title}`}
        >
          <div class="project-cover h-40 overflow-hidden">
            <img src={project.image} alt={`Vista previa de ${project.title}`} class="h-full w-full object-cover" loading="lazy" />
          </div>

          <div class="flex flex-1 flex-col p-5">
            <span class="mb-3 w-fit rounded-full px-3 py-1 font-mono text-xs project-type">{project.type}</span>
            <h3 class="text-xl font-bold text-primary">{project.title}</h3>
            <p class="mt-2 font-mono text-xs text-accent">{project.stack.join(" · ")}</p>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-secondary">{project.description}</p>

            <div class="project-actions mt-5 grid grid-cols-2 gap-3 pt-4">
              <button type="button" class="details-button rounded-xl px-4 py-2.5 text-sm font-medium" data-open-project={index}>Ver más</button>
              {project.github ? (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="code-button inline-flex items-center justify-center gap-1.5 rounded-xl px-4 py-2.5 text-center text-sm font-medium" data-code-link>
                  Código <ExternalLink size={15} strokeWidth={1.8} aria-hidden="true" />
                </a>
              ) : (
                <span class="private-button rounded-xl px-4 py-2.5 text-center text-sm">
                  {project.codeStatus ?? "Privado"}
                </span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <dialog id="project-dialog" class="project-dialog m-auto w-[min(92vw,760px)] overflow-hidden rounded-3xl p-0">
    <div class="relative">
      <button type="button" class="dialog-close absolute right-4 top-4 z-20 flex h-10 w-10 items-center justify-center rounded-xl text-xl" aria-label="Cerrar detalles">×</button>
      <div class="dialog-cover h-52 overflow-hidden md:h-64">
        <img id="dialog-image" src="" alt="" class="h-full w-full object-cover" />
      </div>

      <div class="p-6 md:p-8">
        <span id="dialog-type" class="project-type mb-4 inline-flex rounded-full px-3 py-1 font-mono text-xs"></span>
        <h3 id="dialog-title" class="text-3xl font-bold text-primary"></h3>
        <p id="dialog-stack" class="mt-2 font-mono text-sm text-accent"></p>
        <p id="dialog-detail" class="mt-6 leading-relaxed text-secondary"></p>

        <p class="mt-6 font-mono text-xs uppercase tracking-widest text-muted-sem">Lo que construí</p>
        <ul id="dialog-highlights" class="mt-3 space-y-2 text-secondary"></ul>

        <div class="mt-7 flex flex-wrap gap-3">
          <a id="dialog-code" href="#" target="_blank" rel="noopener noreferrer" class="code-button inline-flex rounded-xl px-5 py-3 text-sm font-medium">
            Ver código fuente
          </a>
          <a id="dialog-demo" href="#" target="_blank" rel="noopener noreferrer" class="details-button inline-flex rounded-xl px-5 py-3 text-sm font-medium">
            Ver demo
          </a>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script define:vars={{ projects }}>
  const dialog = document.querySelector("#project-dialog");

  if (dialog instanceof HTMLDialogElement) {
    const title = dialog.querySelector("#dialog-title");
    const type = dialog.querySelector("#dialog-type");
    const stack = dialog.querySelector("#dialog-stack");
    const detail = dialog.querySelector("#dialog-detail");
    const image = dialog.querySelector("#dialog-image");
    const highlights = dialog.querySelector("#dialog-highlights");
    const code = dialog.querySelector("#dialog-code");
    const demo = dialog.querySelector("#dialog-demo");

    const openProject = (index) => {
      const project = projects[index];
      if (!project) return;
      title.textContent = project.title;
      type.textContent = project.type;
      stack.textContent = project.stack.join(" · ");
      detail.textContent = project.detail;
      image.src = project.image;
      highlights.replaceChildren(...project.highlights.map((item) => {
        const li = document.createElement("li");
        li.textContent = `• ${item}`;
        return li;
      }));
      code.hidden = !project.github;
      if (project.github) code.href = project.github;
      demo.hidden = !project.demo;
      if (project.demo) demo.href = project.demo;
      dialog.showModal();
    };

    document.querySelectorAll("[data-project-index]").forEach((card) => {
      card.addEventListener("click", (event) => {
        if (event.target.closest("[data-code-link]")) return;
        openProject(Number(card.dataset.projectIndex));
      });
      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openProject(Number(card.dataset.projectIndex));
        }
      });
    });

    dialog.querySelector(".dialog-close")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      const bounds = dialog.getBoundingClientRect();
      const outside = event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom;
      if (outside) dialog.close();
    });
  }
</script>

<style>
  .project-card, .project-dialog {
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, #160b29 88%, transparent);
  }
  .project-card { transition: transform 220ms ease, border-color 220ms ease; }
  .project-card:hover { transform: translateY(-4px); border-color: rgba(168, 85, 247, 0.5); }
  .project-card:focus-visible { outline: 2px solid #c084fc; outline-offset: 4px; }
  .project-type { color: #e9d5ff; border: 1px solid rgba(255,255,255,.12); background: rgba(11, 5, 20, .68); }
  .project-actions { border-top: 1px solid var(--color-border); }
  .details-button { color: var(--color-text-primary); border: 1px solid var(--color-border); }
  .details-button:hover { background: rgba(168, 85, 247, .12); }
  .code-button { color: #fff; background: linear-gradient(135deg, #a855f7, #ec4899); }
  .private-button { color: var(--color-text-muted); border: 1px solid var(--color-border); }
  .text-accent { color: #c084fc; }
  .project-dialog { max-height: 90vh; overflow-y: auto; }
  .project-dialog::backdrop { background: rgba(5, 2, 12, .78); backdrop-filter: blur(8px); }
  .dialog-close { color: #fff; border: 1px solid rgba(255,255,255,.14); background: rgba(10, 5, 18, .75); }
  :global([data-theme="light"]) .project-card,
  :global([data-theme="light"]) .project-dialog { background: rgba(255,255,255,.92); }
  :global([data-theme="light"]) .text-accent { color: #7e22ce; }
  @media (prefers-reduced-motion: reduce) {
    .project-card { transition: none; }
    .project-card:hover { transform: none; }
  }
</style>
