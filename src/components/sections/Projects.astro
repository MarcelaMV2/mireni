---
const projects = [
  {
    title: "Sansa Designs",
    type: "E-commerce",
    stack: "NestJS · Vue",
    description:
      "Sistema de gestión integral para un emprendimiento textil artesanal boliviano. Automatiza inventario, proveedores, pedidos y pagos con reportes automáticos y catálogo centralizado.",
    image: "/images/sansa.png",
    github: "https://github.com/MarcelaMV2/sis257_tienda_textiles",
  },
  {
    title: "GogoPlay",
    type: "E-commerce",
    stack: "NestJS · Vue",
    description:
      "Plataforma de venta online de juguetes con gestión de productos, carrito de compras y procesamiento de pedidos. Experiencia de compra fluida con administración eficiente del catálogo.",
    image: "/images/gogoplay.png",
    github: "https://github.com/MarcelaMV2/ecommerceSIS324-GoGoPlay",
  },
  {
    title: "Nexo",
    type: "Reclutamiento automatizado",
    stack: "Laravel · React · n8n",
    description:
      "App de reclutamiento inteligente con formularios personalizados y validaciones dinámicas. n8n actúa como motor de decisiones: agenda entrevistas o envía rechazos automáticamente. Los candidatos pueden reprogramar su cita de forma autónoma.",
    image: "/images/nexo.png",
    github: "https://github.com/MarcelaMV2/frontend_nexo",
  },
  {
    title: "Ingeniería Económica",
    type: "Herramienta financiera",
    stack: "Svelte",
    description:
      "Calculadora web para análisis de indicadores financieros en ingeniería económica. Interfaz reactiva que facilita la evaluación de proyectos e inversiones.",
    image: "/images/calculadora.png",
    github: null,
  },
  {
    title: "Venta de Boletos",
    type: "Microservicios",
    stack: "Angular · NestJS",
    description:
      "Arquitectura de microservicios para gestión y venta de boletos. Servicios independientes y escalables con separación clara de responsabilidades.",
    image: "/images/microservicios.png",
    github: "https://github.com/Gonzales-Franz-Reinaldo/proyecto-microservicios",
  },
  {
    title: "MicroFinder",
    type: "App móvil",
    stack: "React Native",
    description:
      "Aplicación móvil para visualizar en tiempo real las rutas de microbuses en la ciudad de Sucre, Bolivia. Navegación urbana más simple y accesible para todos.",
    image: "/images/microfinder.png",
    github: "https://github.com/MarcelaMV2/MicroFinder",
  },
];
---

<section class="py-2" id="projects">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="mb-12">
      <span class="text-muted-sem text-sm tracking-widest uppercase font-mono">Proyectos</span>
      <h2 class="text-3xl md:text-4xl font-bold text-primary mt-2">
        Lo que he construido
      </h2>
      <p class="text-secondary mt-3 max-w-xl">
        Proyectos académicos y personales donde apliqué distintas tecnologías para resolver problemas reales.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class="proj-card group relative flex flex-col rounded-2xl overflow-hidden transition-all duration-300">

          <!-- Imagen -->
          <div class="relative h-44 overflow-hidden proj-img-bg">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
            />
            <!-- Fallback -->
            <div class="hidden absolute inset-0 items-center justify-center proj-img-bg">
              <span class="text-faint text-4xl font-bold font-mono">
                {project.title.slice(0, 2).toUpperCase()}
              </span>
            </div>
            <!-- Badge tipo -->
            <span class="proj-badge absolute top-3 left-3 text-xs font-mono px-2 py-1 rounded-full">
              {project.type}
            </span>
          </div>

          <!-- Contenido -->
          <div class="flex flex-col flex-1 p-5 gap-3">
            <div>
              <h3 class="text-primary font-semibold text-lg leading-tight">{project.title}</h3>
              <span class="text-muted-sem text-xs font-mono">{project.stack}</span>
            </div>
            <p class="text-secondary text-sm leading-relaxed flex-1">
              {project.description}
            </p>

            <!-- Footer -->
            <div class="pt-2 proj-footer-border">
              {project.github ? (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="proj-link inline-flex items-center gap-2 text-sm transition-colors duration-200 group/link"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                  </svg>
                  <span class="group-hover/link:underline underline-offset-2">Ver repositorio</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover/link:opacity-100 transition-opacity -translate-x-1 group-hover/link:translate-x-0 transition-transform duration-200">
                    <path d="M7 17L17 7M7 7h10v10"/>
                  </svg>
                </a>
              ) : (
                <span class="proj-private text-xs font-mono">Repositorio privado</span>
              )}
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .proj-card {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .proj-card:hover {
    border-color: var(--color-border-hover);
  }
  .proj-img-bg {
    background: var(--color-surface);
  }
  .proj-badge {
    background: var(--color-badge-bg);
    color: var(--color-badge-text);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
  }
  .proj-footer-border {
    border-top: 1px solid var(--color-border);
  }
  .proj-link {
    color: var(--color-link);
  }
  .proj-link:hover {
    color: var(--color-link-hover);
  }
  .proj-private {
    color: var(--color-repo-private);
  }
</style>