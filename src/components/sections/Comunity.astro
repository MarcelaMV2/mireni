---
import ComunitySection from "./ComunitySection.astro";
import { communities } from "../../data/communities";
---

<section class="py-24" id="comunidad">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-white">Comunidad</h2>
      <p class="text-white/60 mt-2">Espacios donde colaboro y comparto conocimiento</p>
    </div>
    <div class="space-y-24">
      {communities.map((comunity) => (
        <ComunitySection {...comunity} />
      ))}
    </div>
  </div>
</section>