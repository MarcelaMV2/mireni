---
import { Icon } from "astro-icon/components";

const redes = [
  {
    nombre: "Instagram",
    usuario: "@mireni_mv",
    url: "https://instagram.com/mireni_mv",
    icono: "simple-icons:instagram",
    colorIcono: "bg-gradient-to-br from-pink-500 via-red-500 to-purple-600",
    hoverTexto: "group-hover:text-pink-400",
  },
  {
    nombre: "Facebook",
    usuario: "Marcela Miranda",
    url: "https://www.facebook.com/share/1AjmNwa6pF/",
    icono: "simple-icons:facebook",
    colorIcono: "bg-blue-600",
    hoverTexto: "group-hover:text-blue-400",
  },
  {
    nombre: "LinkedIn",
    usuario: "Marcela Miranda Veniz",
    url: "https://www.linkedin.com/in/marcela-miranda-veniz-015853352?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app",
    icono: "simple-icons:linkedin",
    colorIcono: "bg-sky-600",
    hoverTexto: "group-hover:text-sky-400",
  },
  {
    nombre: "GitHub",
    usuario: "@MarcelaMV2",
    url: "https://github.com/MarcelaMV2",
    icono: "simple-icons:github",
    colorIcono: "bg-zinc-900",
    hoverTexto: "group-hover:text-gray-300",
  },
  {
    nombre: "Telegram",
    usuario: "@mireni_mv",
    url: "https://t.me/mireni_mv",
    icono: "simple-icons:telegram",
    colorIcono: "bg-sky-500",
    hoverTexto: "group-hover:text-sky-300",
  },
  {
    nombre: "Correo",
    usuario: "mirandamarcela578@gmail.com",
    url: "mailto:mirandamarcela578@gmail.com",
    icono: "lucide:mail",
    colorIcono: "bg-red-500",
    hoverTexto: "group-hover:text-red-300",
  },
  {
    nombre: "WhatsApp",
    usuario: "+591 67399831",
    url: "https://wa.me/59167399831",
    icono: "simple-icons:whatsapp",
    colorIcono: "bg-green-500",
    hoverTexto: "group-hover:text-green-300",
  },
];
---

<section class="py-1">
  <div class="max-w-6xl mx-auto px-6">
    <!-- HEADER -->
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10"
    >
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-white">
          Conecta conmigo
        </h2>

        <p class="text-white/60 mt-2">
          Redes sociales donde comparto mi trabajo y proyectos
        </p>
      </div>
    </div>

    <!-- GRID -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-4">
      {
        redes.map((red) => (
          <a
            href={red.url}
            target={red.url.startsWith("mailto:") ? "_self" : "_blank"}
            rel="noopener noreferrer"
            aria-label={`Ir a ${red.nombre}`}
            class="group p-5 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl hover:scale-105 hover:bg-white/10 hover:border-white/20 transition duration-300 flex flex-col items-center text-center"
          >
            <div
              class={`w-14 h-14 rounded-xl ${red.colorIcono} flex items-center justify-center text-white shadow-lg mb-4`}
            >
              <Icon name={red.icono} class="w-7 h-7" />
            </div>

            <p class={`text-white font-medium transition ${red.hoverTexto}`}>
              {red.nombre}
            </p>

            <p class="mt-1 text-sm text-white/50 truncate max-w-full">
              {red.usuario}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
